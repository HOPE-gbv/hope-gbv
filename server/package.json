{
  "name": "my-app",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsup src/app.ts --format esm,cjs --dts --out-dir dist",
    "start": "node dist/app.js",
    "clean": "rm -rf dist node_modules pnpm-lock.yaml",
    "db:generate": "  prisma generate",
    "db:migrate": "  prisma migrate dev ",
    "db:push": "prisma db push",
    "db:studio": "prisma studio ",
    "db:seed": "tsx src/script/seed-db.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@vercel/postgres": "^0.10.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.43.1",
    "drizzle-seed": "^0.3.1",
    "pg": "^8.16.0",
    "zod": "^3.25.13"
  },
  "devDependencies": {
    "@prisma/client": "^6.8.2",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.17.46",
    "@types/pg": "^8.15.2",
    "drizzle-kit": "^0.31.1",
    "hono": "^4.7.9",
    "prisma": "^6.8.2",
    "ts-node": "^10.9.2",
    "tsup": "^8.4.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}